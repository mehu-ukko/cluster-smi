[Unit]
Description=cluster-smi router (collects GPU stats from cluster-smi-node)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cluster-smi-router
# /etc/cluster-smi/cluster-smi.yaml or .yml is read by default; uncomment to use another file
#Environment=CLUSTER_SMI_CONFIG_PATH=/path/to/cluster-smi.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

## Add me by: sudo systemctl enable cluster-smi-router.service

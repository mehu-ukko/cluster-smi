[Unit]
Description=cluster-smi node (pushes GPU stats to cluster-smi-router)
Wants=network-online.target
After=network-online.target nvidia-persistenced.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cluster-smi-node
# /etc/cluster-smi/cluster-smi.yaml or .yml is read by default; uncomment to use another file
#Environment=CLUSTER_SMI_CONFIG_PATH=/path/to/cluster-smi.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

## Add me by: sudo systemctl enable cluster-smi-node.service
